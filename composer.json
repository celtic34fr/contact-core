{
  "name": "celtic34fr/contact-core",
  "description": "📦 Bolt extension Contact Core base functionalities.",
  "type": "bolt-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "Gilbert ARMENGAUD",
      "email": "gilbert.armengaud@gmail.com"
    }
  ],
  "require": {
    "php": "^8.0",
    "bolt/core": "^5.1",
    "twig/twig": "^3.15",
    "nucleos/dompdf-bundle": "^4.0",
    "symfony/console": "^5.1",
    "bolt/tnt-search-engine": "^0.2.5"
  },
  "require-dev": {
    "phpstan/phpstan": "^0.12.48",
    "phpstan/phpstan-doctrine": "^0.12.20",
    "phpstan/phpstan-symfony": "^0.12.8",
    "phpunit/phpunit": "^9.5",
    "symfony/browser-kit": "^5.1",
    "symfony/css-selector": "^5.1",
    "symfony/phpunit-bridge": "^7.1",
    "symplify/easy-coding-standard": "^9.4"
},
  "autoload": {
    "psr-4": {
      "Celtic34fr\\ContactCore\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
        "Celtic34fr\\ContactCore\\Tests\\": "tests/",
        "Bolt\\Tests\\": "vendor/bolt/common/tests/phpunit/unit/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "entrypoint": "Celtic34fr\\ContactCore\\Extension"
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "drupol/composer-packages": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
